---
import { getCollection, render } from 'astro:content';
import SmartImage from '../../components/SmartImage.astro';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Tag from '../../components/Tag.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      index: i,
      total: projects.length,
      /* The design wraps around at both ends rather than dead-ending. */
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, index, total, prev, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const counter = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
/* Images live inline in the case study body now, the way the live site reads,
   so there is no separate gallery block. The `gallery` field stays in the CMS
   schema as an escape hatch but is not rendered. */
const hasQuote = Boolean(p.testimonial.quote);
---

<Base
  title={`${p.name} — ${p.client} case study`}
  description={p.subtitle}
  image={p.heroImage}
>
  <div class="page">
    <header class="topbar pad">
      <a href="/#my-work" class="back">
        <Icon name="arrow-left" size={16} />
        <span>All work</span>
      </a>
      <span class="counter">{counter}</span>
    </header>

    <section class="intro pad">
      <div class="intro-stack">
        <div class="eyebrow">
          <span>Case Study</span><span class="dot">·</span><span>{p.year}</span>
        </div>
        <h1 class="title">{p.name}</h1>
        <p class="subtitle">{p.subtitle}</p>
      </div>
    </section>

    <div class="pad hero-wrap">
      <div class="hero">
        <SmartImage
          src={p.heroImage}
          alt={p.name}
          widths={[640, 1024, 1440, 1920]}
          sizes="(max-width: 768px) 100vw, min(1240px, 100vw)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="body pad">
      <aside class="rail">
        <div class="railgrid">
          <div class="meta">
            <span class="meta-label">Client</span>
            <span class="meta-value">{p.client}</span>
          </div>
          <div class="meta">
            <span class="meta-label">Role</span>
            <span class="meta-value">{p.role}</span>
          </div>
          <div class="meta">
            <span class="meta-label">Year</span>
            <span class="meta-value nums">{p.year}</span>
          </div>
          {
            p.tools.length > 0 && (
              <div class="meta wide">
                <span class="meta-label">Tools</span>
                <div class="tools">
                  {p.tools.map((t) => (
                    <Tag>{t}</Tag>
                  ))}
                </div>
              </div>
            )
          }
        </div>
        <span class="rule"></span>
        {
          p.liveUrl && (
            <Button variant="primary" icon="arrow-right" href={p.liveUrl}>
              View live project
            </Button>
          )
        }
        {
          p.links.length > 0 && (
            <div class="extra-links">
              {p.links.map((l) => (
                <a href={l.href} class="extra-link" target="_blank" rel="noreferrer">
                  <span>{l.label}</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              ))}
            </div>
          )
        }
        <Button variant="outline" icon="calendar" href="/#contact">Start a project</Button>
      </aside>

      <main class="main">
        <p class="lead">{p.summary}</p>

        <div class="prose">
          <Content />
        </div>

        {
          p.keyLesson && (
            <aside class="lesson">
              <span class="lesson-label">Key lesson</span>
              <p>{p.keyLesson.replace(/\*\*/g, '')}</p>
            </aside>
          )
        }

        {
          hasQuote && (
            <blockquote class="pull">
              <p>{p.testimonial.quote}</p>
              {p.testimonial.author && <cite>{p.testimonial.author}</cite>}
            </blockquote>
          )
        }
      </main>
    </div>

    <nav class="pairnav pad">
      <div class="pair">
        <a href={`/work/${prev.id}`} class="pair-card">
          <span class="pair-dir">Previous</span>
          <span class="pair-name">{prev.data.name}</span>
        </a>
        <a href={`/work/${next.id}`} class="pair-card is-next">
          <span class="pair-dir">Next</span>
          <span class="pair-name">{next.data.name}</span>
        </a>
      </div>
    </nav>
  </div>

  {
    (
      <div class="lightbox" data-lightbox-root hidden>
        <button type="button" class="lightbox-close" aria-label="Close">
          <Icon name="x" size={24} />
        </button>
        <img data-lightbox-img src="" alt="" />
      </div>
    )
  }
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-lightbox-root]');
  if (root) {
    const img = root.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const close = () => {
      root.hidden = true;
      document.body.style.overflow = '';
    };
    const open = (src: string) => {
      img.src = src;
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      root.querySelector<HTMLButtonElement>('.lightbox-close')?.focus();
    };

    document
      .querySelectorAll<HTMLElement>('[data-lightbox]')
      .forEach((btn) => btn.addEventListener('click', () => open(btn.dataset.lightbox!)));

    /* Images inside the body are plain <img> from Markdoc, so wire them up here
       rather than asking Ana to mark anything up when she writes. */
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((im) => {
      im.style.cursor = 'zoom-in';
      im.addEventListener('click', () => open(im.currentSrc || im.src));
    });
    root.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.hidden) close();
    });
  }
</script>

<style>
  .page {
    background: var(--blush-025);
    color: var(--text-body);
    font-family: var(--font-sans);
    min-height: 100vh;
    padding-bottom: var(--space-20);
  }
  .pad { padding-left: clamp(24px, 6vw, 96px); padding-right: clamp(24px, 6vw, 96px); }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    background: color-mix(in srgb, var(--blush-025) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-hairline);
  }
  .back {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-700);
    text-decoration: none;
    border: none;
  }
  .back:hover { color: var(--coral-500); }
  .counter {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  .intro {
    padding-top: clamp(48px, 7vw, 104px);
    padding-bottom: var(--space-10);
    max-width: var(--max-content);
    margin: 0 auto;
  }
  .intro-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
    animation: ani-fade-in-up var(--duration-reveal) var(--ease-out) both;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--coral-500);
  }
  .dot { color: var(--ink-300); }
  .title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.8rem, 6.4vw, 5rem);
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
    color: var(--text-title);
    margin: 0;
    max-width: 18ch;
  }
  .subtitle {
    font-weight: 600;
    font-style: italic;
    font-size: var(--text-h4);
    line-height: var(--leading-subtitle);
    color: var(--text-accent);
    margin: 0;
    max-width: 40ch;
  }

  .hero-wrap { max-width: var(--max-content); margin: 0 auto; }
  .hero {
    height: min(64vh, 620px);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--blush-200);
    box-shadow: var(--shadow-md);
    animation: ani-scale-in var(--duration-slow) var(--ease-out) 120ms both;
  }
  .hero :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .body {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(40px, 7vw, 104px);
    max-width: var(--max-content);
    margin: 0 auto;
    padding-top: clamp(48px, 6vw, 88px);
    align-items: start;
  }

  .rail {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .railgrid { display: flex; flex-direction: column; gap: var(--space-5); }
  .meta { display: flex; flex-direction: column; gap: 6px; }
  .meta.wide { gap: 10px; }
  .meta-label {
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-400);
  }
  .meta-value { font-size: var(--text-body-sm); color: var(--text-body); font-weight: 600; }
  .nums { font-variant-numeric: tabular-nums; }
  .tools { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .rule { height: 1px; background: var(--border-hairline); }

  .main {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 88px);
    min-width: 0;
  }
  .lead {
    font-weight: 400;
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--text-body);
    margin: 0;
    max-width: var(--measure-prose);
  }

  /* ── Case study body ──────────────────────────────────────────────────
     The body is free-form Markdoc, but the design calls for numbered coral
     chapters. A CSS counter numbers each top-level heading, so Ana writes
     "## The Problem" and the 01 / 02 / 03 appears on its own — no manual
     numbering to keep in sync when sections are added or reordered. */
  /* <Content /> wraps the rendered body in its own <article>, so the spacing
     container has to be that element as well as .prose itself — otherwise the
     gap applies to a single child and does nothing. */
  .prose,
  .prose :global(article) {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .prose { counter-reset: chapter; }

  .prose :global(h2) {
    counter-increment: chapter;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: baseline;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--text-h2);
    line-height: var(--leading-title);
    color: var(--text-title);
    margin: var(--space-10) 0 0;
  }
  .prose :global(h2)::before {
    content: counter(chapter, decimal-leading-zero);
    font-size: var(--text-h3);
    color: var(--coral-500);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .prose :global(h2:first-child) { margin-top: 0; }

  /* Sub-headings sit in the text column, aligned under the chapter title. */
  .prose :global(h3),
  .prose :global(h4) {
    margin: var(--space-6) 0 0 96px;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--text-h4);
    line-height: var(--leading-tight);
    color: var(--text-title);
  }

  .prose :global(p) {
    margin: 0 0 0 96px;
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--text-body);
    max-width: var(--measure-prose);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 0 96px;
    padding-left: var(--space-5);
    max-width: var(--measure-prose);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .prose :global(li) {
    font-size: var(--text-body-md);
    line-height: var(--leading-body);
    color: var(--text-body);
  }
  .prose :global(li)::marker { color: var(--coral-500); }
  .prose :global(strong) { font-weight: 700; color: var(--text-title); }
  .prose :global(a) { font-weight: 600; }
  .prose :global(img) {
    display: block;
    width: 100%;
    max-width: var(--measure-prose);
    height: auto;
    margin: var(--space-2) 0 var(--space-2) 96px;
    border-radius: var(--radius-lg);
    background: transparent;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .prose :global(img:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .prose :global(blockquote) {
    margin: 0 0 0 96px;
    padding-left: var(--space-6);
    border-left: 2px solid var(--coral-500);
    font-style: italic;
    color: var(--text-muted);
    max-width: var(--measure-prose);
  }

  /* ── Key lesson callout ─────────────────────────────────────────────── */
  .lesson {
    margin-left: 96px;
    background: var(--surface-card);
    border-left: 3px solid var(--coral-500);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--measure-prose);
  }
  .lesson-label {
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--coral-500);
  }
  .lesson p {
    margin: 0;
    font-size: var(--text-body-md);
    line-height: var(--leading-body);
    color: var(--text-body);
  }

  /* ── Sidebar extra links ────────────────────────────────────────────── */
  .extra-links { display: flex; flex-direction: column; gap: var(--space-3); }
  .extra-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    border: none;
  }


  .pull {
    margin: 0;
    background: var(--blush-100);
    border-radius: var(--radius-xl);
    padding: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .pull p {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--text-title);
    margin: 0;
    max-width: 28ch;
  }
  .pull cite {
    font-style: normal;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--text-accent);
  }

  .pairnav {
    max-width: var(--max-content);
    margin: clamp(64px, 8vw, 112px) auto 0;
    padding-top: var(--space-10);
    border-top: 1px solid var(--border-hairline);
  }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .pair-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    border: none;
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .pair-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .pair-card.is-next { text-align: right; }
  .pair-dir {
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-400);
  }
  .pair-name {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--text-h4);
    color: var(--text-title);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(63, 65, 66, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 5vw, 72px);
    animation: ani-fade-in var(--duration-base) var(--ease-out) both;
  }
  .lightbox[hidden] { display: none; }
  .lightbox img {
    max-width: 1100px;
    width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .lightbox-close {
    position: absolute;
    top: clamp(16px, 3vw, 32px);
    right: clamp(16px, 3vw, 32px);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--surface-card);
    color: var(--ink-700);
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  @media (max-width: 1024px) {
    .body { grid-template-columns: 1fr; gap: 40px; }
    .rail { position: static; }
  }

  @media (max-width: 768px) {
    /* Reclaim the chapter gutter — on a phone the number sits above the title. */
    .prose :global(h2) { grid-template-columns: 1fr; gap: var(--space-2); }
    .prose :global(h3),
    .prose :global(h4),
    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol),
    .prose :global(img),
    .prose :global(blockquote),
    .lesson { margin-left: 0; }
    .prose :global(ul),
    .prose :global(ol) { padding-left: var(--space-5); }
  }

  @media (max-width: 768px) {
    .pad { padding-left: 20px; padding-right: 20px; }
    .title { font-size: 2.4rem; }
    .hero { height: 46vh; }
    .pair { grid-template-columns: 1fr; }
    .pair-card.is-next { text-align: left; }
    .lead { max-width: none; }
  }
</style>
