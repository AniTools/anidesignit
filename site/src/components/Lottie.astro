---
/* The design's Lottie slots. The player is a WASM-backed web component, so it
   is dynamically imported only once the element scrolls into view — the
   fallback (the brand mark on blush) renders until then, and stays put if the
   URL is empty or the player fails to load.

   Note the single root element: Astro only forwards a parent's scoped styles to
   a child component whose template has one top-level element, and the parent is
   what sizes and positions these slots. */
interface Props {
  src?: string;
  class?: string;
  /* Omit for decorative loops — they are then hidden from assistive tech
     rather than announced as an image with no name. */
  label?: string;
}
const { src, class: className, label } = Astro.props;
---

<div
  class:list={['ds-lottie', className]}
  data-lottie={src || undefined}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <div class="fallback" aria-hidden="true">
    <img src="/assets/logo-mark.svg" alt="" width="72" height="72" />
  </div>
</div>

<script>
  const slots = document.querySelectorAll<HTMLElement>('[data-lottie]');
  if (slots.length) {
    let loading: Promise<unknown> | null = null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const host = entry.target as HTMLElement;
          io.unobserve(host);
          loading ??= import('@lottiefiles/dotlottie-wc');
          loading
            .then(() => {
              const player = document.createElement('dotlottie-wc');
              player.setAttribute('src', host.dataset.lottie!);
              player.setAttribute('autoplay', '');
              player.setAttribute('loop', '');
              player.style.width = '100%';
              player.style.height = '100%';
              player.style.display = 'block';
              host.replaceChildren(player);
            })
            /* Keep the brand-mark fallback rather than leaving a blank hole. */
            .catch(() => {});
        }
      },
      { rootMargin: '200px' }
    );
    slots.forEach((s) => io.observe(s));
  }
</script>

<style>
  .ds-lottie { display: block; }
  .fallback {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-xl);
    background: var(--blush-100);
    display: grid;
    place-items: center;
  }
  .fallback img { width: 72px; height: auto; opacity: 0.5; }
  /* A decorative loop has no business animating for someone who asked for less
     motion; the still fallback is the better frame. */
  @media (prefers-reduced-motion: reduce) {
    .ds-lottie :global(dotlottie-wc) { display: none; }
  }
</style>
