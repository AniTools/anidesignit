---
/* Lucide icon, inlined at build time from lucide-static — same glyph set the
   design system used from CDN, but with no network request and no icon flash. */
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import send from 'lucide-static/icons/send.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import circleCheck from 'lucide-static/icons/circle-check.svg?raw';
import circleAlert from 'lucide-static/icons/circle-alert.svg?raw';
import compass from 'lucide-static/icons/compass.svg?raw';
import palette from 'lucide-static/icons/palette.svg?raw';
import layout from 'lucide-static/icons/layout-dashboard.svg?raw';
import monitor from 'lucide-static/icons/monitor.svg?raw';
import code from 'lucide-static/icons/code.svg?raw';
import play from 'lucide-static/icons/play.svg?raw';
import penTool from 'lucide-static/icons/pen-tool.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import instagram from 'lucide-static/icons/instagram.svg?raw';
import linkedin from 'lucide-static/icons/linkedin.svg?raw';
import github from 'lucide-static/icons/github.svg?raw';
import youtube from 'lucide-static/icons/youtube.svg?raw';

const ICONS: Record<string, string> = {
  'arrow-right': arrowRight,
  'arrow-left': arrowLeft,
  calendar,
  send,
  menu,
  x,
  'check-circle': circleCheck,
  'alert-circle': circleAlert,
  compass,
  palette,
  layout,
  monitor,
  code,
  play,
  'pen-tool': penTool,
  sparkles,
  instagram,
  linkedin,
  github,
  youtube,
};

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 20, strokeWidth = 2, class: className } = Astro.props;

const raw = ICONS[name];
if (!raw && import.meta.env.DEV) console.warn(`Icon: no glyph for "${name}"`);

const svg = (raw ?? '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`);
---

<span
  class:list={['ds-icon', className]}
  aria-hidden="true"
  style={`width:${size}px;height:${size}px`}
  set:html={svg}
/>

<style>
  .ds-icon {
    display: inline-flex;
    flex: 0 0 auto;
  }
  .ds-icon :global(svg) {
    display: block;
    stroke: currentColor;
  }
</style>
