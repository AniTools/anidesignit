---
/* Ported from _ds Button.jsx. Hover/press moved from React state to CSS so the
   button needs no client JS. */
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconPosition?: 'left' | 'right';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'right',
  href,
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href && !disabled ? 'a' : 'button';
const glyphSize = size === 'lg' ? 20 : 18;
const extra = Tag === 'a' ? { href } : { type, disabled };
---

<Tag class:list={['ds-btn', `is-${variant}`, `is-${size}`, className]} {...extra} {...rest}>
  {icon && iconPosition === 'left' && <Icon name={icon} size={glyphSize} />}
  <slot />
  {icon && iconPosition === 'right' && <Icon name={icon} size={glyphSize} />}
</Tag>

<style>
  .ds-btn {
    font-family: var(--font-sans);
    font-weight: 600;
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-content: center;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .ds-btn:hover {
    border-bottom-color: transparent;
  }

  .is-sm { padding: 9px 18px; font-size: var(--text-body-sm); }
  .is-md { padding: 13px 26px; font-size: var(--text-body-md); }
  .is-lg { padding: 17px 34px; font-size: var(--text-body-lg); }

  .is-primary {
    background: var(--coral-500);
    color: var(--text-on-accent);
    box-shadow: var(--shadow-accent);
  }
  .is-primary:hover { background: var(--coral-600); color: var(--text-on-accent); }

  .is-secondary { background: var(--surface-inverse); color: var(--text-on-inverse); }
  .is-secondary:hover { background: var(--ink-800); color: var(--text-on-inverse); }

  .is-outline {
    background: transparent;
    color: var(--coral-500);
    box-shadow: inset 0 0 0 1px var(--coral-500);
  }
  .is-outline:hover { background: var(--coral-500); color: var(--text-on-accent); }

  .is-ghost { background: transparent; color: var(--ink-700); }
  .is-ghost:hover { background: var(--state-hover-surface); color: var(--ink-700); }

  .ds-btn:active:not(:disabled) {
    background: var(--state-press-accent);
    transform: scale(0.98);
  }

  .ds-btn:disabled {
    background: var(--state-disabled-bg);
    color: var(--state-disabled-fg);
    box-shadow: none;
    cursor: not-allowed;
    transform: none;
  }
</style>
