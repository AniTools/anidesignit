---
/* Ported from _ds ProjectCard.jsx — cover in a fixed-overflow frame that scales
   on hover, then name, role, summary, tool tags. */
import Tag from './Tag.astro';

interface Props {
  name: string;
  role?: string;
  summary?: string;
  image: string;
  tools?: string[];
  href?: string;
  class?: string;
}
const { name, role, summary, image, tools = [], href = '#', class: className } = Astro.props;
---

<a href={href} class:list={['ds-card', className]}>
  <div class="cover">
    <img src={image} alt={name} loading="lazy" decoding="async" />
  </div>
  <div class="body">
    {role && <div class="role">{role}</div>}
    <h3>{name}</h3>
    {summary && <p>{summary}</p>}
    {
      tools.length > 0 && (
        <div class="tools">
          {tools.map((t) => (
            <Tag>{t}</Tag>
          ))}
        </div>
      )
    }
  </div>
</a>

<style>
  .ds-card {
    display: block;
    text-decoration: none;
    border: none;
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  .ds-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
    border-bottom-color: transparent;
  }
  .cover {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--blush-200);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .ds-card:hover .cover img { transform: scale(1.03); }
  .body { padding: var(--space-6); }
  .role {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--coral-500);
    margin-bottom: var(--space-2);
  }
  h3 {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--text-h4);
    color: var(--text-title);
    margin: 0 0 var(--space-2);
    line-height: var(--leading-tight);
  }
  p {
    font-size: var(--text-body-sm);
    color: var(--text-muted);
    line-height: var(--leading-body);
    margin: 0 0 var(--space-4);
    max-width: none;
  }
  .tools { display: flex; flex-wrap: wrap; gap: var(--space-2); }
</style>
