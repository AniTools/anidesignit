---
/* Ported from _ds SectionHeading.jsx — the brand's title + coral-italic-subtitle pairing. */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, subtitle, align = 'left', class: className } = Astro.props;
---

<header class:list={['ds-heading', `is-${align}`, className]}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <h2>{title}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</header>

<style>
  .ds-heading { margin-bottom: var(--space-10); }
  .is-left { text-align: left; }
  .is-center { text-align: center; }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--coral-500);
    margin-bottom: var(--space-3);
  }
  h2 {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--text-h1);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
    color: var(--text-title);
    margin: 0;
  }
  .subtitle {
    font-family: var(--font-sans);
    font-weight: 600;
    font-style: italic;
    font-size: var(--text-subtitle);
    line-height: var(--leading-subtitle);
    color: var(--text-accent);
    margin: var(--space-3) 0 0;
    max-width: var(--measure-prose);
  }
  .is-center .subtitle { margin-left: auto; margin-right: auto; }
</style>
